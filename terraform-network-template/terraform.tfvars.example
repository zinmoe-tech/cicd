aws_region  = "us-east-1"
project_name = "my-project"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

allowed_ssh_cidrs = []

enable_nat_gateway = true
single_nat_gateway = true

common_tags = {
  Owner = "platform"
}

